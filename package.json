{
  "name": "customsuno",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "installer": "tauri build --bundles nsis",
    "predev": "node scripts/prepare-audio-codecs.mjs",
    "prebuild": "node scripts/prepare-audio-codecs.mjs && node scripts/prepare-licenses.mjs",
    "installer:linux": "tauri build --bundles deb,appimage"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/dm-sans": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "acorn": "^8.18.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoocordStudios/CustomSuno.git"
  }
}
